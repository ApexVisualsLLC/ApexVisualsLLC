# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string. Auto-injected once the Vercel Postgres
# integration is connected in the Vercel dashboard (pull locally with
# `vercel env pull .env.local`). Code checks DATABASE_URL, POSTGRES_URL,
# STORAGE_DATABASE_URL, and STORAGE_POSTGRES_URL, in that order — this
# project's actual variable ended up prefixed as STORAGE_DATABASE_URL.
DATABASE_URL=
# STORAGE_DATABASE_URL=

# Resend (transactional email) — create an account at resend.com, get an API
# key, and a verified "from" address (their sandbox address works for local
# testing before a sending domain is verified).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin login for /admin — pick a long, random password. Not the same secret
# as the session signing key below.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Daily backup of the bookings table to a Google Sheet (see vercel.json for
# the cron schedule). GOOGLE_SHEETS_CLIENT_EMAIL and _PRIVATE_KEY come from a
# Google Cloud service account JSON key (Sheets API only, no other project
# roles needed) — share the target spreadsheet with that service account's
# email as an Editor. The spreadsheet must have a tab named exactly
# "Bookings". GOOGLE_SHEETS_SPREADSHEET_ID is the id from the sheet's URL
# (not secret). CRON_SECRET is generated with: openssl rand -base64 24 —
# Vercel sends it automatically as a Bearer token when calling the cron
# route, so only Vercel's own scheduler can trigger a backup.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
CRON_SECRET=

# Real availability data, replacing the placeholder schedule
# (src/lib/availability/mock-source.ts). Reuses the same service account as
# the Sheets backup above (GOOGLE_SHEETS_CLIENT_EMAIL / _PRIVATE_KEY) — just
# share a dedicated "Apex Visuals Bookings" Google Calendar with that
# service account's email ("See only free/busy" is enough) and set this to
# that calendar's ID (Calendar settings -> "Integrate calendar" -> Calendar
# ID; looks like an email ending in @group.calendar.google.com). Leave unset
# for local dev — the placeholder schedule is used automatically instead.
GOOGLE_CALENDAR_ID=
